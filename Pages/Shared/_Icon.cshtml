@model string
<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Model)
    {
        case "calendar":
            <rect x="3" y="5" width="18" height="16" rx="2" />
            <path d="M16 3v4M8 3v4M3 10h18m-12 5h.01m3 0h.01m3 0h.01m-6 3h.01m3 0h.01" />
            break;
        case "book":
            <path d="M12 6c-3-2-6-3-10-2v15c4-1 7 0 10 2 3-2 6-3 10-2V4c-4-1-7 0-10 2Zm0 0v15" />
            break;
        case "slides":
            <rect x="3" y="4" width="18" height="12" rx="1" />
            <path d="M12 16v5m-4 0h8M7 8h10m-10 4h6" />
            break;
        case "video":
            <rect x="2.5" y="4.5" width="19" height="15" rx="2" />
            <path d="m10 8.5 6 3.5-6 3.5v-7Z" />
            break;
        case "lock":
            <rect x="4.5" y="10" width="15" height="11" rx="2" />
            <path d="M8 10V7a4 4 0 1 1 8 0v3m-4 4.5v2.5" />
            break;
        case "pin":
            <path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" />
            <circle cx="12" cy="10" r="2.2" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
            break;
        case "account":
            <circle cx="12" cy="7" r="3.25" />
            <path d="M5 21v-2a7 7 0 0 1 14 0v2" />
            break;
        case "download":
            <path d="M12 3v12m-4-4 4 4 4-4M4 17v4h16v-4" />
            break;
    }
</svg>
