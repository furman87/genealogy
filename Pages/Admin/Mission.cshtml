@page "/admin/mission"
@model Genealogy.Pages.Admin.MissionModel
@{
    ViewData["Title"] = "Mission statement";
}
@if (Model.Status is not null)
{
    <p class="notice" role="status">@Model.Status</p>
}
<form method="post" class="editor-form panel">
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <div class="field">
        <label asp-for="Mission">Homepage mission statement</label>
        <textarea asp-for="Mission" rows="8" maxlength="2000" aria-describedby="mission-help"></textarea>
        <small id="mission-help">Changes appear on the homepage as soon as you save.</small>
        <span asp-validation-for="Mission" class="validation"></span>
    </div>
    <button class="button button-primary" type="submit">Save mission statement</button>
</form>
