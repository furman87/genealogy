@page "/account/password"
@model Genealogy.Pages.Account.PasswordModel
@{
    ViewData["Title"] = "Change password";
}
<section class="shell auth-shell">
    <div class="auth-card">
        <span class="icon-tile"><partial name="_Icon" model='"lock"' /></span>
        <h1>Change password</h1>
        <p>Signed in as @User.Identity?.Name</p>
        @if (Model.Status is not null)
        {
            <p class="notice" role="status">@Model.Status</p>
        }
        <form method="post" class="editor-form">
            <div asp-validation-summary="ModelOnly" class="validation"></div>
            <div class="field">
                <label asp-for="Input.Current">Current password</label>
                <input asp-for="Input.Current" autocomplete="current-password">
                <span asp-validation-for="Input.Current" class="validation"></span>
            </div>
            <div class="field">
                <label asp-for="Input.New">New password</label>
                <input asp-for="Input.New" autocomplete="new-password" aria-describedby="password-help">
                <small id="password-help">Use at least 12 characters.</small>
                <span asp-validation-for="Input.New" class="validation"></span>
            </div>
            <div class="field">
                <label asp-for="Input.Confirm">Confirm new password</label>
                <input asp-for="Input.Confirm" autocomplete="new-password">
                <span asp-validation-for="Input.Confirm" class="validation"></span>
            </div>
            <button class="button button-primary" type="submit">Change password</button>
        </form>
    </div>
</section>
