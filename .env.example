# Production loopback port used by both Compose and Nginx.
APP_HOST_PORT=5186

# Add the actual site domain alongside the two loopback names.
CLUB_HOSTS='localhost;127.0.0.1'

# Use only to create the first administrator. Remove both entries after setup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Change both entries together if this range overlaps a network on the server.
PROXY_SUBNET=172.29.186.0/24
PROXY_GATEWAY=172.29.186.1
